# AI-Driven DevOps Configuration Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# AI MODEL PROVIDER CONFIGURATION
# =============================================================================
# Choose your AI provider: "bedrock", "claude", or "openai"
MODEL_PROVIDER=bedrock

# AWS Bedrock Configuration (Enterprise)
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
# AWS credentials will be handled by aws-actions/configure-aws-credentials in GitHub Actions
# For local development, use AWS CLI or environment variables:
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Claude Configuration (Advanced Reasoning)
CLAUDE_MODEL_ID=claude-3-5-sonnet-20241022
CLAUDE_API_KEY=sk-ant-api03-your_claude_api_key_here

# OpenAI Configuration (Popular Choice)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_MODEL_ID=gpt-4

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================
# Prometheus metrics endpoint
PROM_URL=https://prometheus.example.com

# Grafana dashboard configuration
GRAFANA_URL=https://grafana.example.com
GRAFANA_TOKEN=glsa_your_grafana_token_here

# Application URL for health checks
APP_URL=https://your-app.example.com/

# =============================================================================
# NOTIFICATION CHANNELS
# =============================================================================
# Telegram Bot Configuration (Optional but Recommended)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# =============================================================================
# KUBERNETES CONFIGURATION
# =============================================================================
# Target namespace to monitor
NAMESPACE=default

# Application name (auto-detected if not specified)
APP_NAME=your-app-name

# Cluster name (auto-detected if not specified)
CLUSTER_NAME=your-cluster-name

# =============================================================================
# ADVANCED CONFIGURATION
# =============================================================================
# AI Analysis Configuration
ANOMALY_SENSITIVITY=medium          # low, medium, high
ALERT_COOLDOWN_MINUTES=15          # Minutes between duplicate alerts
MAX_REMEDIATION_ATTEMPTS=3         # Max auto-remediation attempts

# Health Scoring Thresholds
HEALTH_THRESHOLD=80                # Minimum health score (0-100)
BLOCKING_MODE=true                 # Block deployments on low health scores

# Simulation Mode (for testing without real infrastructure)
AI_OBSERVABILITY_SIMULATION=false  # Set to true for testing

# =============================================================================
# CI/CD CONTEXT (Usually provided by GitHub Actions)
# =============================================================================
# These are typically set automatically by your CI/CD pipeline
CI_PIPELINE_ID=github-run-id
CI_ENVIRONMENT=production
CI_COMMIT_SHA=commit-sha-hash

# =============================================================================
# ENVIRONMENT-SPECIFIC RECOMMENDATIONS
# =============================================================================

# Development Environment:
# MODEL_PROVIDER=openai
# OPENAI_MODEL_ID=gpt-3.5-turbo
# HEALTH_THRESHOLD=60
# BLOCKING_MODE=false

# Staging Environment:
# MODEL_PROVIDER=claude
# CLAUDE_MODEL_ID=claude-3-5-sonnet-20241022
# HEALTH_THRESHOLD=75
# BLOCKING_MODE=false

# Production Environment:
# MODEL_PROVIDER=bedrock
# BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
# HEALTH_THRESHOLD=85
# BLOCKING_MODE=true